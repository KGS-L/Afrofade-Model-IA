# Environment configuration for Afrofade Monorepo

# Frontend Next.js Configuration
NEXT_PUBLIC_APP_URL=https://afrofade.pro
NEXT_PUBLIC_API_URL=https://api.afrofade.pro
INTERNAL_API_URL=http://api:8000

# Backend FastAPI Configuration
API_PORT=8000
FASTAPI_ENV=development

# Supabase / Database Configuration (To be filled in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co  @ #Cliquez à gauche sur Data API pour copier l'URL du projet (du type https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key #👉 C'est la Publishable key (celle qui commence par sb_publishable_...).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key #C'est la Secret key (celle qui commence par sb_secret_...).

# Mobile Money Payment Configuration
MONEY_FUSION_API_KEY=your-money-fusion-api-key
GENIUS_PAY_API_KEY=your-genius-pay-api-key
