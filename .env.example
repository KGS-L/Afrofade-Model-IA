# Environment configuration for Afrofade Production (Copied to VPS via CI/CD)

# Frontend Next.js Configuration
NEXT_PUBLIC_APP_URL=https://afrofade.pro
NEXT_PUBLIC_API_URL=https://api.afrofade.pro
API_INTERNAL_URL=http://api:8000
API_INTERNAL_SECRET=replace-with-a-long-random-secret
API_ALLOWED_ORIGINS=https://afrofade.pro

# Host Ports
WEB_PORT=3005
API_PORT=8005
FASTAPI_ENV=production

# Supabase / Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Durable AI worker
AI_WORKER_ENABLED=true
AI_WORKER_ID=
AI_WORKER_CLAIM_LIMIT=1
AI_WORKER_LEASE_SECONDS=300
AI_WORKER_HEARTBEAT_SECONDS=60
AI_WORKER_POLL_SECONDS=2
AI_WORKER_RECOVER_LIMIT=100

# Hair providers (server-only; all remain OFF by default)
HAIR_PROVIDER_MANUAL_ENABLED=false
HAIR_PROVIDER_TRELLIS2_ENABLED=false
HAIR_PROVIDER_HUNYUAN_MULTIVIEW_ENABLED=false
HAIR_PROVIDER_MESHY_ENABLED=false
FAL_KEY=
FAL_TRELLIS2_WEBHOOK_BASE_URL=https://api.afrofade.pro/webhooks/fal/trellis2
FAL_TRELLIS2_LORA_SPARSE_STRUCTURE=https://example.invalid/private/afrofade-sparse.safetensors
FAL_TRELLIS2_LORA_GEOMETRY=https://example.invalid/private/afrofade-geometry.safetensors
FAL_TRELLIS2_LORA_TEXTURE=https://example.invalid/private/afrofade-texture.safetensors
FAL_TRELLIS2_REQUIRED_LORA_STAGES=sparse_structure,geometry,texture
FAL_TRELLIS2_TIMEOUT_SECONDS=30
FAL_TRELLIS2_POLL_SECONDS=5
FAL_TRELLIS2_POLL_WINDOW_SECONDS=240
FAL_TRELLIS2_RESUBMIT_GRACE_SECONDS=300
FAL_TRELLIS2_MAX_GLB_BYTES=52428800
FAL_WEBHOOK_MAX_BYTES=1048576
FAL_TRELLIS2_PRICE_USD=0
FAL_TRELLIS2_PRICE_USD_1024=0
FAL_USD_TO_FCFA=600

# Scheduled biometric purge
CRON_SECRET=replace-with-a-long-random-secret

# Payment providers
PAYMENT_ENABLED_PROVIDERS=money_fusion
MONEY_FUSION_API_URL=your-money-fusion-dashboard-api-url
MONEY_FUSION_STATUS_URL=https://www.pay.moneyfusion.net/paiementNotif
GENIUS_PAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUS_PAY_API_KEY=pk_sandbox_xxxxxxxx
GENIUS_PAY_API_SECRET=sk_sandbox_xxxxxxxx
GENIUS_PAY_WEBHOOK_SECRET=whsec_xxxxxxxx
