# Environment configuration for Afrofade Monorepo

# Frontend Next.js Configuration
NEXT_PUBLIC_APP_URL=https://afrofade.pro
NEXT_PUBLIC_API_URL=https://api.afrofade.pro
API_INTERNAL_URL=http://api:8000
API_INTERNAL_SECRET=replace-with-a-long-random-secret
API_ALLOWED_ORIGINS=https://afrofade.pro

# Ports hôte
WEB_PORT=3005
API_PORT=8005
FASTAPI_ENV=production

# Supabase / Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Scheduled biometric purge: generate a unique random value in production.
CRON_SECRET=replace-with-a-long-random-secret

# Mobile Money Payment Configuration
MONEY_FUSION_URL=https://www.moneyfusion.net/api/v1/pay
MONEY_FUSION_API_KEY=your-money-fusion-api-key
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
GENIUS_PAY_API_KEY=your-genius-pay-api-key
