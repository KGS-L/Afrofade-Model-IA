# Environment configuration for Afrofade Monorepo

# Frontend Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000

# Backend FastAPI Configuration
API_PORT=8000
FASTAPI_ENV=development

# Supabase / Database Configuration (To be filled in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key

# Mobile Money Payment Configuration
MONEY_FUSION_API_KEY=your-money-fusion-api-key
GENIUS_PAY_API_KEY=your-genius-pay-api-key
